# Copy this file to .env.local and fill in the value (both are gitignored).
# Formspree form ID — the part after /f/ in your form's endpoint.
# Create a form at https://formspree.io, then copy its ID (e.g. "xdoqabcd").
# Endpoint looks like: https://formspree.io/f/xdoqabcd  ->  VITE_FORMSPREE_ID=xdoqabcd
VITE_FORMSPREE_ID=
